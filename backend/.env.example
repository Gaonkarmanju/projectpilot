# Server
PORT=5000
CLIENT_URL=http://localhost:3000

# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://projectpilot:projectpilot@localhost:5432/projectpilot?schema=public"

# Auth - use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI roadmap generation (optional).
# Leave ANTHROPIC_API_KEY empty to use the built-in template generator instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
